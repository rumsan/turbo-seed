{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "prisma:generate:rahat": {
      "cache": false,
      "persistent": false,
      "inputs": ["packages/database/prisma/schema.prisma"],
      "outputs": ["packages/database/client"]
    },
    "prisma:generate": {
      "dependsOn": ["prisma:generate:rahat"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["prisma:generate"],
      "inputs": [".env*"],
      "cache": false,
      "persistent": true
    }
  }
}
